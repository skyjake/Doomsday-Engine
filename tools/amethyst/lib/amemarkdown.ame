$ Amethyst Markdown formatting (with HTML tables).

$*** FORMATTING RULES ***$
@format{@=}
@format{break}{@N}
@format{br}{@_@_@n}

$ Styles.
$ (table and deflist are HTML, so we must style with inline html)
@format{!^table !^deflist order 1  parent em parent !em}{*@=}
@format{!^table !^deflist order -1 parent em parent !em}{@=*}
@format{!^table !^deflist order 1  parent !cmd try strong pass}{**@=}
@format{!^table !^deflist order -1 parent !cmd try strong pass}{@=**}
@format{!^table !^deflist order 1  parent try file opt cmd code pass}{`@=}
@format{!^table !^deflist order -1 parent try file opt cmd code pass}{@=`}
@format{try ^table ^deflist pass order 1  parent em parent !em}{<i>@=}
@format{try ^table ^deflist pass order -1 parent em parent !em}{@=</i>}
@format{try ^table ^deflist pass order 1  parent !cmd try strong pass}{<b>@=}
@format{try ^table ^deflist pass order -1 parent !cmd try strong pass}{@=</b>}
@format{try ^table ^deflist pass order 1  parent try file opt cmd code pass}{<tt>@=}
@format{try ^table ^deflist pass order -1 parent try file opt cmd code pass}{@=</tt>}

$ Preformatted blocks.
@format{pre control}{@< @g @n```@n@B @> @b@n```@N}

$ Blockquote / cite.
@format{order 1 parent try cite code pass}{>@_@=}

$ Remove section numbers; heading text is in child 2.
@format{
    !^contents
    parent child 1
    parent try
        chapter section subsec sub2sec sub3sec
    pass
}{}

$ Titles (only outside the table of contents).
@format{!^contents child 2 parent chapter}{@<##@_@>}
@format{!^contents child 2 parent section}{@<###@_@>}
@format{!^contents child 2 parent subsec}{@<####@_@>}
@format{!^contents child 2 parent sub2sec}{@<#####@_@>}
@format{!^contents child 2 parent sub3sec}{@<######@_@>}

$ Table of contents.
@format{contents}{@< @N}
$@format{parent3 contents @ order -1 parent child 2}{@=@_@_@n}
@format{parent3 contents @ order 1 parent child 1 parent chapter}{
	<div@_style="padding-left:3ex">@_@=}
@format{parent3 contents @ order 1 parent child 1 parent section}{
    <div@_style="padding-left:6ex"><a@_href="#@=">@_@=}
@format{parent3 contents @ order 1 parent child 1 parent subsec}{
    <div@_style="padding-left:9ex"><a@_href="#@=">@_@=}
@format{parent3 contents @ order 1 parent child 2}{@_@=}
@format{parent3 contents @ order -1 parent child 2}{@=</a></div>}

$ Lists.
@format{parent list}{-@_ @>@n}
@format{parent enum list}{@c.@_ @> @n}

$ Definition lists.
@format{deflist}{@< <dl> @> </dl>}
@format{child 1 parent2 deflist}{@< <dt> @> </dt>}
@format{child 2 parent2 deflist}{@< <dd> @> </dd>}

$ Tables.
@format{table}{@< <table@_style="width:75%;">@n @> </table>}
@format{parent table}{@< <tr> @> </tr>@n}
@format{first header @ parent2 table}{@< <th@_style="width:@w%;vertical-align:top;"> @> </th>}
@format{first !header @ parent2 table}{@< <td@_width="width:@w%;vertical-align:top;"> @> </td>}

$*** LENGTH RULES ***$
@length{!text . !text , !text : !text ; !begins ) !begins ] !email !url}{
    try email url pass order 1}{opt !order 1}{spacing 1}
@length{order 1 single}{try text ) text ] pass}{prev try text ( text [ pass}{
    order 1 parent prev try text ( text [ pass}{spacing 0}
@length{list}{spacing 0}
@length{thin deflist}{spacing 0 indent 2}
@length{deflist}{indent 4}
@length{table}{spacing 0 leftmargin 1 rightmargin 1}
@length{large table}{spacing 1}
@length{indent}{leftmargin 4}
