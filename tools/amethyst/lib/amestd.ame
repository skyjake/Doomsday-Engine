$*
    Amethyst Standard Library
    -------------------------

    The following output languages are defined by the library:
     - TXT:      plain text
     - HTML:     HTML/CSS formatted text
     - RTF:      rich text format
     - MAN:      Unix manual page
     - DOKUWIKI: Dokuwiki source
     - WIKI:     Mediawiki source
     - HELP:     Doomsday Help strings
     - MARKDOWN: Markdown (CommonMark with HTML tables)
     - GEMTEXT:  Gemini protocol Gemtext

    Note: For everything to work properly, @begin must be called at the
    beginning of the document.

    TITLE (title of the document) must be defined prior to
    @require{amestd}.
*$

$ Format and length rules
@ifdef{TXT}{ @require{ametxt} }
@ifdef{HTML}{ @require{amehtml} }
@ifdef{RTF}{ @require{amertf} }
@ifdef{MAN}{ @require{ameman} }
@ifdef{DOKUWIKI}{ @require{amedokuwiki} }
@ifdef{WIKI}{ @require{amewiki} }
@ifdef{HELP}{ @require{amehelp} }
@ifdef{MARKDOWN}{ @require{amemarkdown} }
@ifdef{GEMTEXT}{ @require{amegemtext} }

$*** COMMON MACROS ***$

$ Force a space.
@macro{sp}{ @apply{@_}{.} }

$ No spacing.
@macro{nsp}{ @set{spacing 0}{@arg} }

$ No space for the first word.
@macro{glue}{ @single{@arg} }

$ Paragraph heading.
@macro{parag}{
    @ifdef{TXT}{
        __ @glue{@arg} @glue{__}
    }@elifdef{GEMTEXT}{
        @em{@arg}
    }@else{
        @strong{@arg}
    }
}

$ Date.
@macro{date}{ @apply{@D}{yyyy-MM-dd} }

$ Table of contents.
@macro{stdtoc}{CONTENTS: @contents{1 2}}
@macro{toc}{
    @ifdef{MAN}{
        .Sh "TABLE OF CONTENTS" @br
        @contents{1 2}
    }@elifdef{WIKI}{
        $ Mediawiki handles this for us.
        __TOC__
    }@elifdef{GEMTEXT}{
        $ no TOC, client provides one
    }@elifdef{MARKDOWN}{
        $ no TOC, viewer provides one
    }@elifndef{DOKUWIKI}{
        @stdtoc
    }
}

$ Underline.
@macro{underline}{
    @ifdef{HTML}{
        @tag{<span style="text-decoration: underline;">}@arg@tag{</span>}
    }@elifdef{MARKDOWN}{
        @tag{<u>}@arg@tag{</u>}
    }@elifdef{TXT}{
        @arg @apply{@R-}{.}
    }@else{
        @arg
    }
}

$ Double quoting.
@macro{dquote}{
    @ifdef{HTML}{@tag{&#147;}@glue{@arg}@tag{@nsp{&#148;}}}
    @elifdef{TXT}{"@glue{@arg}@nsp{"}} $ previously used LaTeX-like `` and ''
    @else{"@glue{@arg}@nsp{"}}
}

$ Anchor.
@macro{a}{
	@ifdef{HTML}{
		@tag{<a name=@nsp{" @arg "></a>}}
	}
    @ifdef{MARKDOWN}{
        @tag{<a name=@nsp{" @arg "></a>}}
    }
    @ifdef{DOKUWIKI}{
        @tag{<html><a name=@nsp{" @arg "></a></html>}}
    }
}

$ Reference to an anchor.
@macro{ref}{
	@ifdef{HTML}{
		@tag{<a href="#@nsp{@arg{1}">}} @glue{@arg{2}} @tag{@nsp{</a>}}
    }
    @elifdef{MARKDOWN}{
        @tag{[} @glue{@arg{2}} @tag{@nsp{](#@nsp{@arg{1}}@nsp{)}}}
    }
    @elifdef{DOKUWIKI}{
        @tag{<html><a href="#@nsp{@arg{1}">}} @glue{@arg{2}} @tag{@nsp{</a></html>}}
    }
    @elifdef{MAN}{
        @apply{@u}{@arg{2}}
    }
    @else{
        @arg{2}
    }
}

$ Hyperlink with a title.
@macro{link}{
	@ifdef{TXT}{ @arg{1} (@url{@arg{2}}) }
	@ifdef{HTML}{ @tag{ <a href="@nsp{@arg{2}">}@arg{1}@glue{@tag{</a>}} } }
	@ifdef{RTF}{ @tag{@{@nsp{\field@{\*\fldinst@{HYPERLINK} "@nsp{@arg{2}"@}@}@{\fldrslt} @arg{1}@nsp{@}@}}} }
	@ifdef{MAN}{ @arg{1} (@url{@arg{2}}) }
	@ifdef{DOKUWIKI}{[[@glue{@arg{2}}@glue{|}@glue{@arg{1}}@glue{]]}}
	@ifdef{WIKI}{[@arg{2} @arg{1}]}
	@ifdef{MARKDOWN}{ @tag{[}@glue{@arg{1}}@glue{@tag{](}}@glue{@arg{2}}@glue{@tag{)}} }
	@ifdef{GEMTEXT}{ @br @url{=> @sp @arg{2}} @sp @arg{1} @br }
}

$ "mailto:" link.
@macro{mailto}{
    @ifdef{TXT}{ @email{@arg} }
	@ifdef{HTML}{ @tag{ <a href="mailto:@nsp{@arg ">&lt;@arg &gt;</a>} } }
	@ifdef{RTF}{ @email{@arg} }
    @ifdef{MAN}{ @email{@arg} }
    @ifdef{DOKUWIKI}{ @email{@arg} }
    @ifdef{WIKI}{ [@nsp{mailto:@arg @sp @arg{}] } }
	@ifdef{MARKDOWN}{ [@nsp{&lt; @arg &gt;}](mailto:@nsp{@arg}@nsp{)} }
	@ifdef{GEMTEXT}{ @br => mailto:@nsp{@arg} @sp @nsp{@arg} @br }
}

$ Executable/binary file.
@macro{bin}{@strong{@arg}}

$ Document header and any output language specific things.
@macro{begin}{
	@ifdef{HTML}{
		@tag{<head><title>} @TITLE @tag{</title><style type="text/css">body@{font-family:sans-serif;font-size:12pt;max-width:80ex;margin-left:auto;margin-right:auto;background-color:#f0f0f0;color:#444;@}
h1,h2,h3,h4,h5,h6@{color:black;@}
h1@{margin-top:1em;@}
a@{text-decoration:none;color:#061;@}
a:hover@{text-decoration:underline;@}
h1 a,h2 a,h3 a,h4 a,h5 a,h6 a@{color:black;@}
kbd@{font-family:sans-serif;text-transform:uppercase;font-size:80%@}
dt@{margin-top:1em;font-weight:bold;@}
dt tt@{font-weight:normal;@}
ul li@{margin-bottom:1ex;@}
ul li div,ol li div@{margin-bottom:1em;@}</style></head><body>} @break
		@HTMLHEADER
		@tag{<center><h1>} @TITLE @tag{</h1>}
		@ifdef{VERSION}{ @tag{<b>} @VERSION @tag{</b>} @br }
		@ifdef{AUTHOR}{ by @AUTHOR @br }
		@ifdef{EMAIL}{ @mailto{@EMAIL} @br }
		@date @ifdef{LINK}{ @break @link{@LINK}{@LINK} }
		@tag{</center>}
		@break
	}
	@ifdef{WIKI}{
	    $ Mediawiki has its own page header.
	}
    @ifdef{DOKUWIKI}{
        ====== @TITLE ======
    }
	@ifdef{MAN}{
	    .\" manual page generated by Amethyst (mdoc+tbl)@br
        .Dd @apply{@D}{MMMM d, yyyy} @br
        .Os @br
        .Dt @dquote{@apply{@u}{@TITLE}} 6 @br
        .Sh NAME @br
        @TITLE @tag{\-} @ONELINER @br
	}
	@ifdef{TXT}{
		@center{
		    @ifdef{TITLE}{
			    @apply{@n@n}{.}
			    @underline{@TITLE}
			}
			@ifdef{VERSION}{ @VERSION @break }
			@ifdef{AUTHOR}{ by @AUTHOR @br }
			@ifdef{EMAIL}{ @mailto{@EMAIL} @br }
			@date @break
			@ifdef{LINK}{ @LINK }
		}
		@apply{@n@n}{.}
	}
	@ifdef{RTF}{
	    @center{
	        @ifdef{TITLE}{
			    @tag{\line@n}
	            @large{@strong{@TITLE}} @br
	        }
	        @ifdef{VERSION}{
	            @strong{@VERSION} @tag{\@apply{@n}{.}}
	        }
			@ifdef{AUTHOR}{
			    by @ifdef{LINK}{@link{@AUTHOR}{@LINK}}@else{@AUTHOR} @br
		    }
			@ifdef{EMAIL}{ @mailto{@EMAIL} @br }
			@date @br
	    }
	}
	@ifdef{HELP}{
	    $ Doomsday Help does not use a header.
	}
	@ifdef{MARKDOWN}{
	    @tag{# } @TITLE @apply{@n@n}{.}
	    @ifdef{VERSION}{ @tag{**}@glue{@VERSION}@glue{@tag{**}} @br }
	    @ifdef{AUTHOR}{ by @AUTHOR @br }
	    @ifdef{EMAIL}{ @mailto{@EMAIL} @br }
	    @date @ifdef{LINK}{ @break @link{@LINK}{@LINK} }
	    @break
	}
	@ifdef{GEMTEXT}{
	    @tag{# } @TITLE @apply{@n@n}{.}
	    @ifdef{VERSION}{ @VERSION @br }
	    @ifdef{AUTHOR}{
            @ifdef{EMAIL}{
                => mailto:@nsp{@EMAIL} by @AUTHOR
            }@else{
                by @AUTHOR
            }
            @br
        }
        @else{
	        @ifdef{EMAIL}{ @mailto{@EMAIL} @br }
        }
	    @date @ifdef{LINK}{ @break @tag{=> } @LINK }
	    @break
	}
}

$ Specify an author with contact information. (Manual page only.)
@macro{man_author}{
    @ifdef{MAN}{
        .An @dquote{@arg{1}} Aq @sp @nsp{@arg{2}} @br
    }
}

@macro{man_opt}{
    @ifdef{MAN}{
        .Op Fl @arg @br
    }
}

@macro{man_opt2}{
    @ifdef{MAN}{
        .Op Fl @arg{1} Ar @arg{2} @br
    }
}

@macro{ident}{
    @ifdef{DOKUWIKI}{''@arg{}''}
    @elifdef{WIKI}{@{@{Identifier|@glue{@arg}@}@}}
    @elifdef{HELP}{@arg}
    @else{@cmd{@arg}}
}

@macro{help_arg}{
    @ifdef{DOKUWIKI}{//@arg{}//}
    @elifdef{WIKI}{@{@{Argument|@glue{@arg}@}@}}
    @else{(@arg{})}
}

@macro{help_optionalarg}{
    @ifdef{DOKUWIKI}{//[ @arg ]//}
    @elifdef{WIKI}{@{@{Optional|@glue{@help_arg{@arg}}@}@}}
    @else{[@help_arg{@arg}]}
}

$ Makes a special note.
@macro{notice}{
    @ifdef{DOKUWIKI}{@tag{<note>}@arg@tag{</note>}}
    @elifdef{HTML}{
        @tag{<table border="0" cellpadding="3" valign="top"><tr>
        <td><b>NOTE:</b></td><td>}
        @arg @tag{</td></tr></table>}
    }
    @elifdef{MARKDOWN}{ @tag{> **NOTE:**@_}@arg }
    @elifdef{GEMTEXT}{ @tag{NOTE:@_}@arg }
    @else{ @list/note{ @item @arg } }
}

$ Doomsday Engine Wiki specific macros.
@ifdef{DOKUWIKI}{
    @macro{wikiterm}{[[@glue{@arg}]]}
    @macro{wikilink}{[[@glue{@arg{2}}@glue{|}@glue{@arg{1}}]]}
}
@elifdef{WIKI}{
	@macro{wikiterm}{[[@glue{@arg}]]}
	@macro{wikilink}{[[@glue{@arg{2}}@glue{|}@glue{@arg{1}}]]}
}
@elifdef{HTML}{
	@macro{wikilink}{@link{@arg{1}}{@tag{https://manual.dengine.net/@glue{@arg{2}}}}}
    @macro{wikiterm}{@wikilink{@arg}{@arg}}
}
@elifdef{MARKDOWN}{
	@macro{wikilink}{@link{@arg{1}}{@tag{https://manual.dengine.net/@glue{@arg{2}}}}}
    @macro{wikiterm}{@wikilink{@arg}{@arg}}
}
@elifdef{TXT}{
	$ Omit the hyperlinks in TXT files.
	@macro{wikilink}{@arg}
}
@elifdef{GEMTEXT}{
    $ Omit hyperlinks in Gemtext; links must be standalone lines.
    @macro{wikilink}{@link{@arg{1}}{https://manual.dengine.net/@glue{@arg{2}}}}
    @macro{wikiterm}{@arg}
}
@elifdef{HELP}{
    @macro{wikiterm}{@dquote{@arg} in wiki}
}
@else{
	@macro{wikilink}{@link{@arg{1}}{https://manual.dengine.net/@arg{2}}}
	@macro{wikiterm}{@arg}
}
