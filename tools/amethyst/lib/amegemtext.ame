$ Amethyst Gemtext formatting.
@output{table}{fill}

$*** FORMATTING RULES ***$
@format{@=}

$ Basic line/paragraph breaks are preserved.
@format{break}{@N}
@format{br}{@n}

$ Limited inline styling.
$ (Tables are preformatted, so even more limited styling inside them.)
@format{em}{@u}  $ use UPPERCASE for emphasis
@format{!^table !^deflist order 1  parent opt parent !samp}{`@=}
@format{!^table !^deflist order -1 parent opt parent !samp}{@=`}
@format{!^table order 1  parent cmd}{`@=}
@format{!^table order -1 parent cmd}{@=`}

$ Standalone URL elements.
$@format{!^list !^deflist parent url}{@n=>@_@=@n}

$ Headings with number columns: prefix with ## / ### markers.
$@format{^contents parent child 1 parent chapter}{@=.}
@format{!^contents parent child 1 parent chapter}{##@_@=.}
@format{!^contents parent child 1 parent section}{###@_@=}
@format{!^contents parent child 1 parent subsec}{###@_@=}
@format{!^contents parent child 1 parent sub2sec}{###@_@=}
@format{!^contents parent child 1 parent sub3sec}{###@_@=}

$ Tables -- preformatted blocks rendered like plain text.
@format{table}{@< @N```@n @> @n```@N}
@format{single parent table}{@< @r-}

$ Blockquote / cite.
@format
    {parent cite @ order 1}
    {parent cite @ preceding try break linebreak pass}
        {>@_@=}
@format{parent cite @ break}{@> @n>@n}

$ Lists.
@format{parent list @ first !url}{@n*}
$@format{parent list @ first url}{@n=>}
@format{parent enum list}{@n*@_@c) }

$ Definition lists.
@format{child 1 parent2 deflist}{@< @n}     $ ensure break before items
@format{order 1 parent child 1 parent2 deflist}{*@_"@=}
@format{^deflist child 1 try opt file pass parent child 1}{*@_"@=}
@format{child 2 parent2 deflist}{@< ": }

$ Preformatted/examples (`@B`: raw breaks).
@format{order 1 pre parent samp}{@= @< @N```@n@B @> @b@n```@N}

$*** LENGTH RULES ***$

$ Word and punctuation spacing.
@length{!text . !text , !text : !text ; !begins ) !begins ] !email !url}{
    try email url pass order 1}{opt !order 1}{spacing 1}
@length{order 1 single}{try text ) text ] pass}{prev try text ( text [ pass}{
    order 1 parent prev try text ( text [ pass}{spacing 0}

$ Lists.
@length{thin list}{spacing 0}
@length{thin deflist}{spacing 0}

$ Tables use the same column width as plain text format.
$ leftmargin 0 avoids a stale-context padding artifact that would add a
$ spurious leading space to all headings and TOC entries after a table.
@length{table}{spacing 0 leftmargin 0 rightmargin 0 width 65}
