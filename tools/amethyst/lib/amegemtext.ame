$ Amethyst Gemtext formatting.
$@output{fill}
@output{table}{fill}

$*** FORMATTING RULES ***$
@format{@=}

@ifdef{DISABLED}{

@format{break}{@N}
@format{br}{@n}

$ Limited inline styling.
@format{em}{@u}  $ use UPPERCASE for emphasis
@format{order 1 parent opt parent !samp}{`@=}
@format{order -1 parent opt parent !samp}{@=`}

$ Preformatted blocks.
@format{pre !control}{@g @< @B``` @> @N```@b}
$ @samp is wrapped in ``` by processIndent() when width > 0 (see length rule below).

$ Blockquote / cite.
@format{order 1 parent cite}{>@_@=}

$ Standalone URL elements.
@format{parent url}{@N=>@_@=@N}

$ Heading number column: prefix with ## / ### markers.
$ The number (e.g. "1." or "1.1") goes into the number context (child 1),
$ and the title text goes into the text context (child 2) without any prefix.
@format{^contents parent child 1 parent chapter}{@=.}
@format{!^contents parent child 1 parent chapter}{##@_@=.}
@format{!^contents parent child 1 parent section}{###@_@=}
@format{!^contents parent child 1 parent subsec}{###@_@=}
@format{!^contents parent child 1 parent sub2sec}{###@_@=}
@format{!^contents parent child 1 parent sub3sec}{###@_@=}

$ Table of contents entries -- number column shows "1." / "1.1" plain,
$ title text just passes through via the default @= rule.

$ Lists -- Gemtext only supports unordered lists, no nesting.
@format{list}{@< @> }
@format{enum list}{@< @> }
@format{parent list}{*}
@format{parent enum list}{*}
@format{deflist}{@< @> }
@format{order 1 parent child 1 parent2 deflist}{*@_"@=}
@format{order -1 parent child 1 parent2 deflist}{@="}

$ Tables -- preformatted blocks rendered like plain text.
@format{table}{@< @B``` @> @N```@b}
@format{single parent table}{@< @r-}

$*** LENGTH RULES ***$
@length{!text . !text , !text : !text ; !begins ) !begins ] !email !url}{
    try email url pass order 1}{opt !order 1}{spacing 1}
@length{order 1 single}{try text ) text ] pass}{prev try text ( text [ pass}{
    order 1 parent prev try text ( text [ pass}{spacing 0}

$ Unlimited line width for body text so paragraphs are not wrapped.
@length{width 9999}

$ Minimum column width for TOC numbers (handles "1." through "10." and "1.1" etc.).
$ The processContents() zero-width fix still applies when numbers render as empty.
@length{contents}{spacing 4 indent 2}

$ Tables use the same column width as plain text format.
$ leftmargin 0 avoids a stale-context padding artifact that would add a
$ spurious leading space to all headings and TOC entries after a table.
@length{table}{spacing 0 leftmargin 0 rightmargin 0 width 70}
@length{large table}{spacing 1}
@length{thin list}{spacing 0}
@length{deflist}{indent 0}
@length{thin deflist}{spacing 0 indent 0}
@length{indent}{leftmargin 4 width 9999}
@length{list}{spacing 0}

}
